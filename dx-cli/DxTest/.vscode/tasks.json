{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "dx: build (debug)",
            "command": "dx.cmd",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "dx build を実行します(デバッグビルド)。"
        },
        {
            "type": "shell",
            "label": "dx: build (release)",
            "command": "dx.cmd",
            "args": [
                "build",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "dx: run",
            "command": "dx.cmd",
            "args": [
                "run"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "dependsOn": [
                "dx: build (debug)"
            ]
        },
        {
            "type": "shell",
            "label": "dx: test",
            "command": "dx.cmd",
            "args": [
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
