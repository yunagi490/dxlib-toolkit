    "game",
    "cli",
    "mingw",
    "quickjs"
  ],  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunagi490/dxlib-toolkit.git",
    "directory": "dx-cli"
  },
  "homepage": "https://github.com/yunagi490/dxlib-toolkit/tree/main/dx-cli#readme",
  "bugs": {
    "url": "https://github.com/yunagi490/dxlib-toolkit/issues"
  },
  "bin": {
    "dx": "dist/bin/dx.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:self": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
